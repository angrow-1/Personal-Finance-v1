# Plaid API credentials — get these from https://dashboard.plaid.com/
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Anthropic API key — get this from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Plaid access tokens — generated by running: python setup_accounts.py
# Run setup_accounts.py once per account, then paste the resulting tokens here.
PLAID_ACCESS_TOKEN_BANK1=
PLAID_ACCESS_TOKEN_BANK2=
PLAID_ACCESS_TOKEN_PAYPAL=
